// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "buffer_line_height": "comfortable",
  "icon_theme": "Material Icon Theme",
  "show_wrap_guides": true,
  "disable_ai": false,
  "auto_update": true,
  "current_line_highlight": "none",
  "seed_search_query_from_cursor": "never",
  "minimap": {
    "show": "never",
  },
  "edit_predictions": {
    "provider": "copilot",
    "mode": "eager",
    "copilot": {
      "proxy": null,
      "proxy_no_verify": null,
    },
    "enabled_in_text_threads": false,
  },
  "agent": {
    "default_profile": "ask",
    "default_model": {
      "provider": "copilot_chat",
      "model": "claude-opus-4.6",
    },
  },
  "ui_font_size": 13,
  "buffer_font_size": 12,
  "ui_font_features": {
    "italics": true,
  },
  "buffer_font_features": {
    "italics": true,
    "liga": true,
    "calt": true, // font ligatures
  },
  "project_panel": {
    "starts_open": false,
    "auto_fold_dirs": true,
    "scrollbar": {
      "show": "never",
    },
    "indent_guides": {
      "show": "never",
    },
  },
  "scrollbar": {
    "show": "auto",
  },
  "gutter": {
    "min_line_number_digits": 0,
    "folds": false,
    "runnables": false,
  },
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "VSCode Dark Polished",
  },
  "theme_overrides": {
    "VSCode Dark Polished": {
      // "One Dark": {
      "editor.line_number": "#8E979C",
      "hint": "#8E979C",
      "players": [
        {
          "cursor": "#8E979C",
        },
      ],
      "syntax": {
        "comment": {
          "font_style": "italic",
          "color": "#8E979C",
        },
        "keyword": {
          "font_style": "italic",
        },
        "function": {
          "font_style": "italic",
        },
        "attribute": {
          "font_style": "italic",
        },
        "constant": {
          "font_style": "italic",
        },
        "type": {
          "font_style": "italic",
        },
        "comment.doc": {
          "font_style": "italic",
          "color": "#8E979C",
        },
        "hint": {
          "color": "8E979C",
          "font_style": "italic",
          "font_weight": null,
        },
      },
    },
  },
  "tabs": { "file_icons": true },
  "vim_mode": true,
  "cursor_shape": "block",
  "cursor_blink": false,
  "relative_line_numbers": "enabled",
  "ui_font_family": ".SystemUIFont",
  "buffer_font_family": "BlexMono Nerd Font Propo",
  "lsp": {},
  "languages": {
    "C": {
      "show_edit_predictions": false,
    },
    "Zig": {
      "show_edit_predictions": true,
    },
    "Go": {
      "show_edit_predictions": true,
      "tab_size": 4,
      "formatter": "language_server",
      "format_on_save": "on",
      "preferred_line_length": 120,
      "wrap_guides": [120],
    },
    "Rust": {
      "show_edit_predictions": false,
      "tab_size": 4,
      "formatter": "language_server",
      "format_on_save": "on",
      "preferred_line_length": 100,
      "wrap_guides": [100],
    },
    "HTML": {
      "tab_size": 2,
      "formatter": "prettier",
      "format_on_save": "on",
      "preferred_line_length": 150,
    },
    "Python": {
      "language_servers": ["ty"],
      "tab_size": 4,
      "formatter": "language_server",
      "preferred_line_length": 100,
      "wrap_guides": [100],
    },
    "Java": {
      "show_edit_predictions": true,
      "preferred_line_length": 150,
      "formatter": "language_server",
      "wrap_guides": [150],
    },
    "JavaScript": {
      "preferred_line_length": 120,
      "wrap_guides": [120],
    },
    "TypeScript": {
      "preferred_line_length": 120,
      "wrap_guides": [120],
    },
    "Astro": {
      "preferred_line_length": 120,
      "wrap_guides": [120],
    },
    "TSX": {
      "preferred_line_length": 120,
      "wrap_guides": [120],
    },
  },
  "extend_comment_on_newline": false,
  "close_on_file_delete": true,
}
